# 复制为项目目录的 .env 后填写；此文件不含真实秘密。

# WebUI 管理员密码（必填，留空则服务拒绝启动）。
GW_ADMIN_PASSWORD=

# 宿主机监听地址：默认只允许本机访问，内网访问请改为内网网卡 IP。
GW_BIND=127.0.0.1

# 容器内 WebUI 端口；默认映射为 127.0.0.1:8080。
GW_PORT=8080

# 调度器：1–4 个工作线程；同步/发现间隔下限至少为 1 分钟。
GW_TICK_SECONDS=30
GW_WORKERS=2
GW_MIN_SYNC_MINUTES=5
GW_MIN_DISCOVERY_MINUTES=15
# Git 连续无输出多久判为卡死，不限制有进展的运行总时长。
GW_STALL_MINUTES=10
# 仅清理运行日志与操作记录，不清理保全事件、档案和 Git 数据。
GW_LOG_RETENTION_DAYS=90
